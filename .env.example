# Copy this file to .env and fill in your actual API key.
# Never commit the .env file to Git.

NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# The exact model name must match what's listed in your Nebius AI Studio
# account's model catalog (https://studio.nebius.com/ -> Models). Model
# availability and naming changes over time and isn't fully consistent --
# some models are listed with a "meta-llama/" prefix and some aren't, so
# copy the name exactly as shown in the catalog UI rather than guessing.
# A 404 "model does not exist" error means this value doesn't match.
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct